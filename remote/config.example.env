# remote/config.example.env — copy to remote/config.env and edit.
# Sourced by loos-build.py / build-remote.sh. Keep secrets out of git.

# ---- target: Win10 IoT LTSC (or XP/2000) VM over OpenSSH --------------------
REMOTE_HOST=192.168.56.101
REMOTE_USER=loos
REMOTE_PORT=22
# Path (Windows style) where the source tree lives inside the VM.
REMOTE_DIR='C:\loos\srv03rtm'
# Path where the finished ISO is written inside the VM.
REMOTE_ISO_DIR='C:\loos\out'
# Build variant / SKU subdir under %_NTPOSTBLD% used by tools\oscdimg.cmd.
# Common: srv, srv_usa, wks, per, blad.  Default: srv
VARIANT=srv
# Private key (optional; leave blank to use agent/default keys).
SSH_KEY=
# SSH options (disable strict host key for a lab VM; adjust for prod).
SSH_OPTS='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15'

# ---- host outputs -----------------------------------------------------------
# Where the fetched ISO lands on this Linux host (default: external DATA drive).
ISO_OUT=/run/media/silvan/DATA/loos/out/loos.iso
# Local copy of the source tree that gets rsynced to the VM (fast NVMe).
LOCAL_SRC=/home/silvan/LoOS-build/srv03rtm

# ---- QEMU ------------------------------------------------------------------
QEMU_MEM=4096
QEMU_CPUS=4
# Optional data disk for install (created if missing) — on DATA.
QEMU_DISK=/run/media/silvan/DATA/loos/out/loos.qcow2
QEMU_DISK_SIZE=20G
QEMU_ACCEL=kvm          # kvm | tcg
