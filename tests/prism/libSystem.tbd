               _realpath$DARWIN_EXTSN, _mkstemp, _mkdtemp, _sysctlbyname, _close, _unlink, _rmdir, _chdir,
               _sscanf, _setmode, _getmode, _wcwidth, _putwchar, _strtod, _mbrtowc, _strtof,
               _fork, _execl, _execvp, _waitpid, _pipe, _read, ___error, __exit, _environ,
