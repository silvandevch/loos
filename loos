#!/usr/bin/env bash
# loos — one simple command for everything. Run `./loos help`.
#
#   ./loos status            where things live + disk + tool check
#   ./loos setup             fetch source + patchkit, verify layout
#   ./loos prep              overlay + oobe + certs + media tags + missing bins
#   ./loos build             build all implemented LoOS targets on Linux
#   ./loos source-build      build a selected LoOS CMake preset
#   ./loos boot-bios         build the LoOS BIOS boot image
#   ./loos source-build windows-mingw  cross-build LoOS PE apps on Linux
#   ./loos iso               (re)make the bootable ISO
#   ./loos qemu              boot the ISO in QEMU
#   ./loos vm-build          build on the Windows VM over SSH (all steps)
#   ./loos vm <sync|build|iso|fetch|qemu|all>
#   ./loos bus <status|start|stop|send|inbox|task|watch|...>   agent message bus
#   ./loos docs [topic]      read the docs (build, tools, architecture, ...)
#   ./loos relocate SRC OUT  change where source / output live (writes .loosrc)
#   ./loos help
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$HERE/env.sh"

hr() { printf '────────────────────────────────────────────────────────\n'; }

cmd_status() {
    hr; echo "LoOS status"; hr
    printf '  repo        : %s (%s)\n' "$LOOS_ROOT" "$(stat -f -c %T "$LOOS_ROOT" 2>/dev/null)"
    printf '  SRC_ROOT    : %s\n' "$SRC_ROOT"
    printf '  OUT_ROOT    : %s\n' "$OUT_ROOT"
    printf '  source tree : %s\n' "$([ -d "$NT_SRC" ] && echo "present ($(find "$NT_SRC" -path "$NT_SRC/.git" -prune -o -type f -print 2>/dev/null | wc -l) files)" || echo MISSING)"
    printf '  patchkit    : %s\n' "$([ -d "$PATCHKIT" ] && echo present || echo MISSING)"
    hr
    printf '  disk DATA   : %s\n' "$(disk_of "$LOOS_DATA")"
    printf '  disk SRC    : %s\n' "$(disk_of "$SRC_ROOT")"
    hr
    printf '  tools       : '
    for t in git rsync openssl python3 cargo rustc 7z mkisofs qemu-system-x86_64 wine; do
        printf '%s%s ' "$([ "$(command -v $t 2>/dev/null)" ] && echo '' || echo 'MISSING:')" "$t"
    done; echo
    printf '  ISO         : %s\n' "$([ -f "$NT_OUT/loos.iso" ] && du -h "$NT_OUT/loos.iso" | cut -f1 || echo 'not built')"
    hr
}

cmd_docs() {
    local d="$LOOS_ROOT/docs"
    if [ $# -eq 0 ]; then ls "$d"; return; fi
    local f; f="$(ls "$d" 2>/dev/null | grep -i "$1" | head -1)"
    [ -n "$f" ] || { echo "no doc matching '$1'; available:"; ls "$d"; return; }
    ${PAGER:-cat} "$d/$f"
}

cmd_source_build() {
    local preset="${1:-host-clang}"
    case "$preset" in
        host-clang|kernel-clang|windows-msvc|windows-mingw) ;;
        *) die "usage: loos source-build [host-clang|kernel-clang|windows-msvc|windows-mingw]" ;;
    esac
    command -v cmake >/dev/null || die "cmake is required for source-build"
    command -v ninja >/dev/null || die "ninja is required for source-build"
    cmake --preset "$preset" || return $?
    if [ "$preset" = kernel-clang ]; then
        cmake --build --preset kernel-clang || return $?
        log "freestanding kernel libraries built; no boot-image target exists yet"
        return 0
    fi
    if [ "$preset" = host-clang ]; then
        cmake --build --preset host-clang || return $?
        ctest --preset host-clang || return $?
    elif [ "$preset" = windows-mingw ]; then
        cmake --build --preset windows-mingw --target localc locmd lonotepad lotaskmgr || return $?
    elif [ "$preset" = windows-msvc ]; then
        cmake --build --preset windows-msvc || return $?
    fi
}

cmd_boot_bios() {
    [ "$#" -eq 0 ] || die "usage: ./loos boot-bios"
    command -v cmake >/dev/null || die "cmake is required for boot-bios"
    command -v ninja >/dev/null || die "ninja is required for boot-bios"
    cmake --preset host-clang || return $?
    cmake --build --preset host-clang --target loos_boot_bios || return $?
    local image="$OUT_ROOT/cmake/host-clang/boot/bios.img"
    [ -s "$image" ] || die "boot image was not produced: $image"
    log "BIOS boot image: $image"
}

cmd_build() {
    [ "$#" -eq 0 ] || die "usage: ./loos build"
    local host_status=0 kernel_status=0 app_status=0
    log "configuring and building LoOS native modules"
    cmake --preset host-clang || host_status=$?
    if [ "$host_status" -eq 0 ]; then
        cmake --build --preset host-clang || host_status=$?
    fi
    if [ "$host_status" -eq 0 ]; then
        log "running LoOS host tests"
        ctest --preset host-clang || host_status=$?
    else
        warn "native build failed; continuing with kernel and desktop app builds"
    fi

    log "configuring and building LoOS freestanding kernel libraries"
    cmake --preset kernel-clang || kernel_status=$?
    if [ "$kernel_status" -eq 0 ]; then
        cmake --build --preset kernel-clang || kernel_status=$?
    fi
    [ "$kernel_status" -eq 0 ] || warn "kernel library build failed (status $kernel_status); continuing with desktop apps"

    for tool in x86_64-w64-mingw32-gcc x86_64-w64-mingw32-windres; do
        command -v "$tool" >/dev/null 2>&1 || die "missing $tool; install MinGW-w64 to build LoOS desktop apps"
    done
    log "cross-compiling LoOS desktop apps for the PE runtime"
    cmd_source_build windows-mingw || app_status=$?

    if [ "$host_status" -ne 0 ] || [ "$kernel_status" -ne 0 ] || [ "$app_status" -ne 0 ]; then
        [ "$host_status" -eq 0 ] || warn "native build/tests failed (status $host_status)"
        [ "$kernel_status" -eq 0 ] || warn "freestanding kernel build failed (status $kernel_status)"
        [ "$app_status" -eq 0 ] || warn "desktop app build failed (status $app_status)"
        return 1
    fi
    log "all implemented LoOS targets built; no bootable image target is available yet"
}

cmd_relocate() {
    local src="${1:-}" out="${2:-}"
    [ -n "$src" ] || die "usage: loos relocate <SRC_ROOT> [OUT_ROOT]"
    : > "$LOOS_ROOT/.loosrc"
    echo "SRC_ROOT=$src" >> "$LOOS_ROOT/.loosrc"
    [ -n "$out" ] && echo "OUT_ROOT=$out" >> "$LOOS_ROOT/.loosrc"
    log "wrote $LOOS_ROOT/.loosrc"; cat "$LOOS_ROOT/.loosrc"
    warn "existing data is NOT moved automatically; move it with rsync if needed"
}

case "${1:-help}" in
    status)   shift; cmd_status "$@" ;;
    setup)    shift; bash "$SCRIPTS_DIR/00-fetch.sh" && bash "$SCRIPTS_DIR/01-structure.sh" ;;
    prep)     shift; bash "$SCRIPTS_DIR/run-all.sh" ;;
    build)    shift; cmd_build "$@" ;;
    source-build) shift; cmd_source_build "$@" ;;
    boot-bios) shift; cmd_boot_bios "$@" ;;
    iso)      shift; bash "$SCRIPTS_DIR/_iso-run.sh" ;;
    qemu)     shift; bash "$HERE/remote/run-qemu.sh" "$NT_OUT/loos.iso" ;;
    vm-build) shift; python3 "$HERE/remote/loos-build.py" all ;;
    vm)       shift; python3 "$HERE/remote/loos-build.py" "$@" ;;
    verify)   shift; bash "$SCRIPTS_DIR/10-verify-env.sh" ;;
    fixwine)  shift; bash "$SCRIPTS_DIR/fix-wine-assoc.sh" ;;
    bus)      shift; python3 "$HERE/agents/agentbus" "${@:-status}" ;;
    agents)   shift; python3 "$HERE/agents/agentbus" "${@:-status}" ;;
    docs)     shift; cmd_docs "$@" ;;
    relocate) shift; cmd_relocate "$@" ;;
    help|--help|-h|"") awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$HERE/loos" ;;
    *) die "unknown command '$1' — run: ./loos help" ;;
esac
