set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

find_program(LOOS_MINGW_CC NAMES x86_64-w64-mingw32-gcc REQUIRED)
find_program(LOOS_MINGW_RC NAMES x86_64-w64-mingw32-windres REQUIRED)

set(CMAKE_C_COMPILER "${LOOS_MINGW_CC}" CACHE FILEPATH "MinGW-w64 C compiler")
set(CMAKE_RC_COMPILER "${LOOS_MINGW_RC}" CACHE FILEPATH "MinGW-w64 resource compiler")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
