#include <windows.h>

1 ICON "loos-switch.ico"
1 24 "loos-switch.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LoOS"
            VALUE "FileDescription", "LoOS Switch - local-only installer and migration manager"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "loos-switch"
            VALUE "LegalCopyright", "MIT licensed"
            VALUE "OriginalFilename", "loos-switch.exe"
            VALUE "ProductName", "LoOS Switch"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
