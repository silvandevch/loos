{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-clang",
      "displayName": "Host tests (Clang + Ninja)",
      "generator": "Ninja",
      "binaryDir": "$env{OUT_ROOT}/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "kernel-clang",
      "displayName": "Kernel target (Clang x86-64 freestanding)",
      "generator": "Ninja",
      "binaryDir": "$env{OUT_ROOT}/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/kernel-x86_64.cmake",
        "BUILD_TESTING": "OFF",
        "LOOS_BUILD_WIN32": "OFF"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows user mode (clang-cl + MSVC ABI)",
      "generator": "Ninja",
      "binaryDir": "$env{OUT_ROOT}/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-msvc-x64.cmake",
        "BUILD_TESTING": "OFF",
        "LOOS_BUILD_WIN32": "ON",
        "LOOS_BUILD_APPS": "ON"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows PE applications (MinGW-w64 cross-build)",
      "generator": "Ninja",
      "binaryDir": "$env{OUT_ROOT}/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-mingw-x64.cmake",
        "BUILD_TESTING": "OFF",
        "LOOS_BUILD_WIN32": "OFF",
        "LOOS_BUILD_APPS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-clang", "configurePreset": "host-clang" },
    { "name": "kernel-clang", "configurePreset": "kernel-clang" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" }
  ],
  "testPresets": [
    {
      "name": "host-clang",
      "configurePreset": "host-clang",
      "output": { "outputOnFailure": true }
    }
  ]
}
