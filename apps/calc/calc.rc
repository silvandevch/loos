#include <windows.h>
#include "brand.rcinc"

1 RT_MANIFEST "calc.manifest"

1 VERSIONINFO
FILEVERSION LOOS_FILE_VERSION
PRODUCTVERSION LOOS_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", LOOS_COMPANY_TEXT
            VALUE "FileDescription", "LoOS Calculator"
            VALUE "FileVersion", LOOS_FILE_VERSION_TEXT
            VALUE "InternalName", "LoCalc"
            VALUE "OriginalFilename", "LoCalc.exe"
            VALUE "ProductName", "LoOS Calculator"
            VALUE "ProductVersion", LOOS_FILE_VERSION_TEXT
            VALUE "Comments", LOOS_TAGLINE_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
