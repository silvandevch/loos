/* ============================================================================
 *  LoOS/notepad.exe resources - transcribed 1:1 from the genuine UI.
 * ============================================================================
 *  Source: Windows 11 install.wim image 1
 *    Windows/System32/en-US/notepad.exe.mui (menus, dialogs, strings)
 *  The icon (notepad.ico) is an ORIGINAL LoOS design (blue tile, document
 *  with folded corner) - not Microsoft art, to stay clear of copyright.
 *
 *  Every dialog below reproduces the original template exactly: same IDs,
 *  same geometry (dialog units), same styles, same text, same font.
 *    11   "Now Printing" progress dialog shown while printing
 *    12   "Page Setup" custom dialog (paper, orientation, margins,
 *         header/footer, printer button, live preview)
 *    14   "Go To Line" dialog
 *    15   Encoding strip hooked into the Open/Save dialogs
 *    1540 "Find" modeless dialog
 *    1541 "Replace" modeless dialog
 *  Menus, strings and accelerators live in the .mui at runtime; this .c's
 *  twin (notepad_rewrite.c) carries the exact same tables compiled in.
 *
 *  BUILD: rc /fo C:\LoOS\out\notepad.res notepad.rc
 * ============================================================================
 */

#include <windows.h>
#include <commdlg.h>
#include "brand.rcinc"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/* Application manifest: comctl32 v6, PerMonitorV2 DPI, long paths.
 * Linked into the single exe (ID 1); edit + rebuild to change. */
1 RT_MANIFEST "notepad.exe.manifest"

2 ICON "notepad.ico"

/* ---- 11: Now Printing -------------------------------------------------- */
11 DIALOGEX 20, 20, 200, 64
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Now Printing"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Cancel", 2, "Button",
        BS_DEFPUSHBUTTON | WS_TABSTOP | WS_GROUP | WS_CHILD | WS_VISIBLE,
        84, 44, 32, 14
    CTEXT "Now Printing", 65535, 0, 8, 200, 8
    CONTROL "", 20, "Static",
        SS_CENTER | SS_NOPREFIX | WS_CHILD | WS_VISIBLE,
        0, 18, 200, 8
    CTEXT "", 21, 0, 28, 200, 8
END

/* ---- 12: Page Setup ----------------------------------------------------- */
12 DIALOGEX 0, 0, 356, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Page Setup"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Paper", 1073, 8, 8, 224, 56
    LTEXT           "Si&ze:", 1089, 16, 24, 36, 8
    COMBOBOX        1137, 64, 23, 160, 160,
        CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Source:", 1090, 16, 45, 36, 8
    COMBOBOX        1138, 64, 42, 160, 160,
        CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Orientation", 1072, 8, 69, 64, 56
    AUTORADIOBUTTON "P&ortrait", 1056, 16, 82, 52, 12, WS_TABSTOP | WS_GROUP
    AUTORADIOBUTTON "L&andscape", 1057, 16, 103, 52, 12
    GROUPBOX        "Margins", 1075, 80, 69, 152, 56
    LTEXT           "&Left:", 1102, 88, 85, 32, 8
    EDITTEXT        1155, 120, 82, 28, 12, ES_AUTOHSCROLL
    LTEXT           "&Right:", 1103, 164, 85, 32, 8
    EDITTEXT        1157, 196, 82, 28, 12, ES_AUTOHSCROLL
    LTEXT           "&Top:", 1104, 88, 104, 32, 8
    EDITTEXT        1156, 120, 103, 28, 12, ES_AUTOHSCROLL
    LTEXT           "&Bottom:", 1105, 164, 104, 32, 8
    EDITTEXT        1158, 196, 103, 28, 12, ES_AUTOHSCROLL
    LTEXT           "&Header:", 32, 8, 135, 29, 8
    EDITTEXT        30, 56, 134, 174, 12, ES_AUTOHSCROLL
    LTEXT           "&Footer:", 33, 8, 154, 29, 8
    EDITTEXT        31, 56, 153, 174, 12, ES_AUTOHSCROLL
    CONTROL         "<A>Input Values</A>", 34, "SysLink",
        WS_TABSTOP | WS_VISIBLE | WS_CHILD, 56, 170, 153, 8
    DEFPUSHBUTTON   "OK", 1, 190, 174, 50, 14
    PUSHBUTTON      "Cancel", 2, 244, 174, 50, 14
    PUSHBUTTON      "&Printer...", 1026, 298, 174, 50, 14
    GROUPBOX        "Preview", 65535, 240, 8, 108, 158
    CONTROL         "", 1080, "Static",
        SS_WHITERECT | WS_VISIBLE | WS_CHILD, 254, 46, 80, 80
    CONTROL         "", 1081, "Static",
        SS_GRAYRECT | WS_VISIBLE | WS_CHILD, 334, 50, 4, 80
    CONTROL         "", 1082, "Static",
        SS_GRAYRECT | WS_VISIBLE | WS_CHILD, 262, 122, 80, 4
END

/* ---- 14: Go To Line ----------------------------------------------------- */
14 DIALOGEX 0, 0, 166, 60
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To Line"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT         "&Line number:", 1200, 7, 7, 115, 8
    EDITTEXT      258, 7, 18, 151, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON "Go To", 1, 55, 39, 50, 14
    PUSHBUTTON    "Cancel", 2, 109, 39, 50, 14
END

/* ---- 15: Encoding strip for the Open/Save hook -------------------------- */15 DIALOGEX 30, 17, 300, 22
STYLE DS_SETFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
CAPTION ""
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT    "&Encoding:", 259, 68, 1, 40, 40
    COMBOBOX 257, 130, 0, 164, 100, CBS_DROPDOWNLIST | WS_TABSTOP
END

/* ---- 1540: Find ---------------------------------------------------------
 * MODERNIZED: resizable (thick frame) + regex checkbox (1043) + live match
 * count (1089). Original geometry above is otherwise untouched. */
1540 DIALOGEX 30, 73, 236, 94
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Find"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Fi&nd what:", 65535, 4, 8, 42, 8
    EDITTEXT        1152, 47, 7, 128, 12, ES_AUTOHSCROLL
    CONTROL         "Match &whole word only", 1040, "Button",
        BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP | WS_CHILD | WS_VISIBLE,
        4, 26, 100, 12
    AUTOCHECKBOX    "Match &case", 1041, 4, 42, 64, 12
    AUTOCHECKBOX    "W&rap around", 1042, 4, 58, 64, 12
    AUTOCHECKBOX    "Use regular e&xpressions", 1043, 4, 74, 140, 12
    LTEXT           "", 1089, 150, 74, 80, 12
    GROUPBOX        "Direction", 1072, 107, 26, 68, 28
    AUTORADIOBUTTON "&Up", 1056, 111, 38, 25, 12, WS_TABSTOP | WS_GROUP
    AUTORADIOBUTTON "&Down", 1057, 138, 38, 35, 12
    DEFPUSHBUTTON   "&Find Next", 1, 182, 5, 50, 14
    PUSHBUTTON      "Cancel", 2, 182, 23, 50, 14
    PUSHBUTTON      "&Help", 1038, 182, 45, 50, 14
    CONTROL         "", 1088, "Static", WS_CHILD, 4, 56, 1, 1
END

/* ---- 1541: Replace ------------------------------------------------------
 * MODERNIZED: same treatment as Find. */
1541 DIALOGEX 36, 44, 230, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Replace"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Fi&nd what:", 65535, 4, 9, 48, 8
    EDITTEXT        1152, 54, 7, 114, 12, ES_AUTOHSCROLL
    LTEXT           "Re&place with:", 65535, 4, 26, 48, 8
    EDITTEXT        1153, 54, 24, 114, 12, ES_AUTOHSCROLL
    CONTROL         "Match &whole word only", 1040, "Button",
        BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP | WS_CHILD | WS_VISIBLE,
        4, 46, 104, 12
    AUTOCHECKBOX    "Match &case", 1041, 4, 62, 59, 12
    AUTOCHECKBOX    "W&rap around", 1042, 4, 78, 64, 12
    AUTOCHECKBOX    "Use regular e&xpressions", 1043, 4, 94, 140, 12
    LTEXT           "", 1089, 150, 94, 74, 12
    DEFPUSHBUTTON   "&Find Next", 1, 174, 4, 50, 14
    PUSHBUTTON      "&Replace", 1024, 174, 21, 50, 14
    PUSHBUTTON      "Replace &All", 1025, 174, 38, 50, 14
    PUSHBUTTON      "Cancel", 2, 174, 55, 50, 14
    PUSHBUTTON      "&Help", 1038, 174, 75, 50, 14
    CONTROL         "", 1088, "Static", WS_CHILD, 4, 76, 1, 1
END

/* ---- 16: About (ours, themed; icon 2 = the LoOS logo) ------------------- */
16 DIALOGEX 0, 0, 260, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About LoOS Notepad"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         2, 65535, "Static", SS_ICON | WS_CHILD | WS_VISIBLE,
                    12, 12, 32, 32
    LTEXT           "", 101, 52, 10, 196, 72
    DEFPUSHBUTTON   "OK", 1, 105, 92, 50, 14
END

1 VERSIONINFO
FILEVERSION LOOS_FILE_VERSION
PRODUCTVERSION LOOS_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", LOOS_COMPANY_TEXT
            VALUE "FileDescription", LOOS_APP_NOTEPAD_TEXT
            VALUE "FileVersion", LOOS_FILE_VERSION_TEXT
            VALUE "InternalName", "LoNotepad"
            VALUE "OriginalFilename", "LoNotepad.exe"
            VALUE "ProductName", LOOS_APP_NOTEPAD_TEXT
            VALUE "ProductVersion", LOOS_FILE_VERSION_TEXT
            VALUE "Comments", LOOS_TAGLINE_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
